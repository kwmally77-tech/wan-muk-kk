# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this in Vercel Dashboard > Project Settings > Environment Variables (or AI Studio Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: Password for accessing the Admin Regulations Panel (defaults to admin1234).
ADMIN_PASSWORD="admin1234"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
